{
  "name": "codexorbitts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "next-sitemap --config next-sitemap.config.mjs && node scripts/copy-sitemaps.js && node scripts/test-sitemap.js",
    "start": "next start",
    "lint": "next lint",
    "analyze": "cross-env ANALYZE=true next build",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepare": "husky install",
    "sitemap": "next-sitemap --config next-sitemap.config.mjs",
    "generate-sitemaps": "node scripts/test-sitemap.js"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^15.3.1",
    "@prisma/client": "^5.10.2",
    "@types/prismjs": "^1.26.5",
    "compression-webpack-plugin": "^11.1.0",
    "critters": "^0.0.25",
    "mysql2": "^3.14.0",
    "next": "15.3.0",
    "next-sitemap": "^4.2.3",
    "nprogress": "^0.2.0",
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "tailwindcss": "^4.1.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^20",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.3.0",
    "postcss": "^8.5.3",
    "prisma": "^5.10.2",
    "typescript": "^5.3.3"
  }
}
